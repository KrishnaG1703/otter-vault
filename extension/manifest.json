{
  "manifest_version": 3,
  "name": "Otter Vault",
  "version": "0.6.2",
  "description": "Catches one-time API keys and passwords as you create them, keeps them in an encrypted vault, and shares them with your team.",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "clipboardRead",
    "clipboardWrite",
    "identity"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Otter Vault",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/art.js",
        "content/cursor-art.js",
        "content/secret-detect.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
